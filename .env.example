# Copia este archivo a .env (nunca a git). systemd lo carga con EnvironmentFile;
# en el portátil, expórtalo en la shell (set -a; . ./.env; set +a).

# LLM: Claude (station.yaml → providers.llm). Alternativa sin variable: `ant auth login`.
ANTHROPIC_API_KEY=

# TTS en la nube (solo si station.yaml → providers.tts.name es cloud/elevenlabs).
ELEVENLABS_API_KEY=

TELEGRAM_BOT_TOKEN=
